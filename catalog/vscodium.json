{
  "$schema": "../schema/tool.schema.json",
  "id": "vscodium",
  "name": "VSCodium",
  "description": "Community-driven, freely-licensed binary distribution of Microsoft’s editor VS Code",
  "homepage": "https://github.com/VSCodium/vscodium",
  "updateDelayDays": 3,
  "target": {
    "type": "directory",
    "directoryName": "vscodium"
  },
  "version": {
    "remote": {
      "source": "git-ls-remote",
      "repositoryUrl": "https://github.com/VSCodium/vscodium.git",
      "excludePattern": "alpha|beta|\\{\\}",
      "tagVersionExtractRegex": "refs/tags/(\\d+\\.\\d+\\.\\d+(?:\\.\\d+)?)",
      "sortStrategy": "semver"
    },
    "local": {
      "source": "version-file",
      "fileName": "VERSION"
    }
  },
  "download": {
    "urlTemplate": "https://github.com/VSCodium/vscodium/releases/download/${version}/${fileName}",
    "fileNameTemplate": "VSCodium-win32-x64-${version}.zip"
  },
  "verification": {
    "checksum": {
      "algorithm": "sha256",
      "source": "sidecar-file",
      "urlTemplate": "https://github.com/VSCodium/vscodium/releases/download/${version}/${fileName}.sha256",
      "encoding": "hex",
      "extractRegex": "^([a-fA-F0-9]{64})"
    }
  },
  "extraction": {
    "format": "zip",
    "method": "direct-7z"
  }
}
